# Get an API key from Google AI Studio and paste it here.
GEMINI_API_KEY=your_gemini_api_key_here

# Change this if your Google AI Studio account does not have access to this model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional settings
DATABASE_URL=sqlite:///./database/quizora.db
MAX_UPLOAD_MB=10
MAX_SOURCE_CHARS=40000
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
